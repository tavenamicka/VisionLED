{
  "name": "visionled",
  "version": "1.0.0",
  "description": "Analyseur de couleurs LED pour daltoniens - Détection temps réel via caméra",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "npx eas-cli build --platform android --profile preview",
    "build:release": "npx eas-cli build --platform android --profile release",
    "test": "jest",
    "lint": "eslint src/",
    "analyze": "react-native-bundle-visualizer"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-navigation/native": "^6.1.9",
    "expo": "^57.0.0",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.18",
    "expo-linear-gradient": "~57.0.2",
    "expo-speech": "~57.0.3",
    "lodash": "^4.17.21",
    "pako": "^2.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@testing-library/react-native": "^12.1.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "react-test-renderer": "19.2.3"
  },
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "author": "tavenamicka",
  "license": "MIT",
  "keywords": [
    "colorblind",
    "accessibility",
    "color-detection",
    "LED-analyzer",
    "daltonien",
    "react-native",
    "expo"
  ]
}
